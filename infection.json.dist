{
    "source": {
        "directories": [
            "src"
        ]
    },
    "logs": {
        "text": "php://stderr",
        "github": true,
        "stryker": {
            "badge": "2.x"
        }
    },
    "mutators": {
        "@default": true,
        "DecrementInteger": {
            "ignoreSourceCodeByRegex": [
                ".*->withPriority\\(99\\).*"
            ]
        },
        "IncrementInteger": {
            "ignoreSourceCodeByRegex": [
                ".*->withPriority\\(99\\).*"
            ]
        }
    },
    "minMsi": 99.20,
    "minCoveredMsi": 100.00
}
